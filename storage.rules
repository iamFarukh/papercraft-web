// For future use when the project upgrades to Blaze and enables Cloud Storage.
// Profile photos and school logos currently use Firestore data URLs (Spark plan).
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /profile-photos/{userId}/{fileName} {
      allow read: if isAuth();
      allow write: if isAuth()
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    match /school-assets/{fileName} {
      allow read: if isAuth();
      allow write: if isAdmin()
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
