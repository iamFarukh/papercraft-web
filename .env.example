# Firebase — copy to .env and fill from Firebase Console → Project settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional on Spark (free) — profile/logo images use Firestore, not Storage
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional — Firebase Analytics
VITE_FIREBASE_MEASUREMENT_ID=

# Dev only — used ONLY in `vite dev` builds (import.meta.env.DEV); ignored in
# production builds. Set to `admin` or `teacher` locally if your users/{uid}
# doc has no role yet. Leave blank otherwise.
VITE_DEV_ROLE=
