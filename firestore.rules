rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return exists(userPath());
    }

    function getUserRole() {
      return hasUserDoc() ? get(userPath()).data.role : '';
    }

    /** Admins explicitly tagged, or legacy user docs with no role field yet. */
    function isAdmin() {
      return isAuth() && hasUserDoc() && (
        !('role' in get(userPath()).data) ||
        get(userPath()).data.role == 'admin'
      );
    }

    function questionNotTrashed() {
      return !('deletedAt' in resource.data) || resource.data.deletedAt == null;
    }

    match /questions/{questionId} {
      allow read: if isAuth() && resource.data.status == 'published' && questionNotTrashed();
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /curriculum_classes/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /curriculum_subjects/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /curriculum_chapters/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /curriculum_topics/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /curriculum_meta/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /papers/{paperId} {
      allow read: if isAuth() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'draft';
      allow update: if isAuth() && (
        isAdmin() ||
        (
          resource.data.createdBy == request.auth.uid
          && resource.data.status == 'draft'
          && (
            request.resource.data.status == 'draft' ||
            (
              request.resource.data.status == 'submitted'
              && request.resource.data.submittedBy == request.auth.uid
              && request.resource.data.submittedAt is timestamp
            )
          )
        )
      );
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      /** Self on first login, or admin provisioning teachers (users/{teacherUid}). */
      allow create: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      match /bookmark_folders/{folderId} {
        allow read, write: if isAuth() && request.auth.uid == userId;

        match /items/{questionId} {
          allow read, write: if isAuth() && request.auth.uid == userId;
        }
      }

      match /bookmark_index/{questionId} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }

    match /teacher_pending/{pendingId} {
      allow read: if isAdmin() || (
        isAuth() &&
        request.auth.token.email != null &&
        resource.data.email == string.lower(request.auth.token.email)
      );
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /blueprints/{blueprintId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /workspace_settings/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
